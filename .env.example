# Copy to .env.local and fill in. Restart `next dev` after changing.
# .env.local is git-ignored; this file is the only env file that gets committed.
#
# RULE: anything named NEXT_PUBLIC_* is compiled into the JavaScript that every
# visitor downloads. Only put values there that are safe for the whole world to
# read. Server secrets go in variables WITHOUT that prefix.

# ── Public (browser) ────────────────────────────────────────────────────────

# Deployed origin (no trailing slash), e.g. https://rang.fm. Used for canonical
# URLs, OpenGraph/Twitter image URLs, sitemap and robots. See lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Supabase — powers the live head-count in each world (Realtime Presence).
# Leave both blank to run without it; the header then shows "RANG FM LIVE".
# Use the PUBLISHABLE key (sb_publishable_..., or the legacy "anon" key).
# NEVER the secret / service_role key: it bypasses row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server only (never prefix these with NEXT_PUBLIC_) ──────────────────────

# Not used yet. If the YouTube Data API is added later, read this only from
# server code (a route handler or server component) and proxy the result.
YOUTUBE_API_KEY=
